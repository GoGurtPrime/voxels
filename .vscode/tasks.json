{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure project",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "./build",
        "-DVOXELS_BUILD_TESTS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build project",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "./build",
        "--config",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
