#pragma once

/**
 * @file version.hpp
 * @brief Generated single-source-of-truth build identity (work_items/18).
 *
 * @details Regenerated by cmake/GenerateVersionHeader.cmake on every build so the git commit
 *          and timestamp never go stale. Do not edit the generated copy under the build
 *          directory; edit this template and the CMake project() version instead. Consumed by
 *          the window title, main-menu corner, log banner, save `engineVersion`, and the
 *          `.vpk` manifest's engine-compatibility field (ARCHITECTURE.md §6.6).
 */

#include <cstdint>

namespace voxels {

inline constexpr const char* kEngineVersion = "@VOXELS_VERSION@";
inline constexpr std::uint32_t kEngineVersionMajor = @VOXELS_VERSION_MAJOR@;
inline constexpr std::uint32_t kEngineVersionMinor = @VOXELS_VERSION_MINOR@;
inline constexpr std::uint32_t kEngineVersionPatch = @VOXELS_VERSION_PATCH@;
inline constexpr const char* kEngineGitCommit = "@GIT_SHA@";
inline constexpr const char* kEngineBuildTimestamp = "@BUILD_TIMESTAMP@";

} // namespace voxels
